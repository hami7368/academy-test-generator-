# Copy to .env for local use. NEVER commit a real .env with real passwords.
# On Render, set these in Dashboard > Environment instead.
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///academy.db
# For Postgres (Neon): postgresql://user:password@host/dbname?sslmode=require
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password-here
# Future AI extraction (NOT implemented yet — see README / Settings page):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
ACADEMY_NAME=My Academy
